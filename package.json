{
  "name": "denti-e-cura",
  "productName": "Denti & Cura",
  "version": "1.0.8",
  "description": "Gestionale per studio dentistico - agenda, pazienti, preventivi e fatturazione",
  "author": "Fioravante Capaccio",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish=never",
    "dist:win:portable": "electron-builder --win portable --x64 --publish=never",
    "dist:mac": "electron-builder --mac --publish=never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "publish": null,
    "appId": "com.fioravantecapaccio.dentiecura",
    "productName": "Denti & Cura",
    "files": [
      "main.js",
      "preload.js",
      "Studio_Dentistico.html"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "category": "public.app-category.medical",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Denti & Cura"
    }
  }
}
